rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
    }

    function isValidCurrency(code) {
      return code in ['PKR', 'USD', 'EUR', 'GBP', 'AED', 'SAR', 'INR', 'CAD'];
    }

    function isValidCategory(cat) {
      return cat in ['food', 'housing', 'transport', 'utilities', 'health', 'shopping', 'entertainment', 'education', 'other'];
    }

    function isValidPaymentMethod(pm) {
      return pm in ['cash', 'card', 'bank', 'wallet'];
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidExchangeRates(rates) {
      return rates is map
        && rates.keys().hasOnly(['PKR', 'USD', 'EUR', 'GBP', 'AED', 'SAR', 'INR', 'CAD'])
        && (!('PKR' in rates) || (rates.PKR is number && rates.PKR > 0 && rates.PKR <= 100000))
        && (!('USD' in rates) || (rates.USD is number && rates.USD > 0 && rates.USD <= 100000))
        && (!('EUR' in rates) || (rates.EUR is number && rates.EUR > 0 && rates.EUR <= 100000))
        && (!('GBP' in rates) || (rates.GBP is number && rates.GBP > 0 && rates.GBP <= 100000))
        && (!('AED' in rates) || (rates.AED is number && rates.AED > 0 && rates.AED <= 100000))
        && (!('SAR' in rates) || (rates.SAR is number && rates.SAR > 0 && rates.SAR <= 100000))
        && (!('INR' in rates) || (rates.INR is number && rates.INR > 0 && rates.INR <= 100000))
        && (!('CAD' in rates) || (rates.CAD is number && rates.CAD > 0 && rates.CAD <= 100000));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'baseCurrency', 'monthlyBudget', 'alertThresholdPct', 'darkMode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'baseCurrency', 'monthlyBudget', 'alertThresholdPct', 'darkMode', 'browserNotifications', 'exchangeRates', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100))
        && isValidCurrency(data.baseCurrency)
        && data.monthlyBudget is number && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000
        && data.alertThresholdPct is number && data.alertThresholdPct >= 50 && data.alertThresholdPct <= 95
        && data.darkMode is bool
        && (!('browserNotifications' in data) || data.browserNotifications is bool)
        && (!('exchangeRates' in data) || isValidExchangeRates(data.exchangeRates))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, userId, expenseId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'amount', 'currency', 'category', 'date', 'paymentMethod', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'amount', 'currency', 'category', 'date', 'paymentMethod', 'notes', 'createdAt', 'updatedAt'])
        && data.id == expenseId
        && isValidId(data.id)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && isValidCurrency(data.currency)
        && isValidCategory(data.category)
        && isValidDateStr(data.date)
        && isValidPaymentMethod(data.paymentMethod)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategoryBudget(data, userId, categoryId) {
      return data.keys().hasAll(['category', 'userId', 'limit', 'updatedAt'])
        && data.keys().hasOnly(['category', 'userId', 'limit', 'updatedAt'])
        && data.category == categoryId
        && isValidCategory(data.category)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.limit is number && data.limit >= 0 && data.limit <= 1000000000
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'baseCurrency', 'monthlyBudget', 'alertThresholdPct', 'darkMode', 'browserNotifications', 'exchangeRates', 'updatedAt']);
      allow delete: if isOwner(userId);

      match /expenses/{expenseId} {
        allow get: if isOwner(userId) && isValidId(expenseId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), userId, expenseId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), userId, expenseId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'currency', 'category', 'date', 'paymentMethod', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(expenseId);
      }

      match /categoryBudgets/{categoryId} {
        allow get: if isOwner(userId) && isValidId(categoryId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(categoryId)
          && isValidCategoryBudget(incoming(), userId, categoryId)
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId)
          && isValidId(categoryId)
          && isValidCategoryBudget(incoming(), userId, categoryId)
          && incoming().category == existing().category
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['limit', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(categoryId);
      }
    }
  }
}
